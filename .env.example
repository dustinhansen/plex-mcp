# Copy to .env and fill in. .env is gitignored.
# The image needs the first 3. The rest are optional, and each commented-out
# value does what leaving the variable unset does in the image.

PLEX_URL=http://<plex-host>:32400
PLEX_TOKEN=your-plex-owner-token
# Generate with: openssl rand -hex 32
MCP_PATH_SECRET=<at-least-16-characters>

# stdio or http. The image sets http (the server alone defaults to stdio).
# MCP_TRANSPORT=http
# Listen port inside the container. Change the container side of -p to match.
# PORT=8627
# HTTP listen address. The image sets 0.0.0.0 (the server alone uses 127.0.0.1).
# MCP_HOST=0.0.0.0
# 1 runs http mode without MCP_PATH_SECRET. Trusted networks only.
# MCP_ALLOW_NO_AUTH=0
# 1 registers list_clients and play_item.
# PLEX_ALLOW_PLAYBACK=0
# 1 registers no write or playback tools, whatever PLEX_ALLOW_PLAYBACK says.
# PLEX_READ_ONLY=0
# Setting both registers the Tautulli tools. One alone is refused at startup.
# TAUTULLI_URL=
# TAUTULLI_API_KEY=
